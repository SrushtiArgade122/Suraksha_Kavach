  "q_fire_1_opt3": "Stop",
  "q_fire_1_ans": "1",
  "tip_fire_1": "If you see fire, shout 'Fire!' loudly to alert others. This helps people realize the danger quickly. Never stay silent. Inform nearby people and move to a safe location.",

  "q_fire_2": "What is the Fire emergency number?",
  "q_fire_2_opt0": "100",
  "q_fire_2_opt1": "101",
  "q_fire_2_opt2": "102",
  "q_fire_2_opt3": "108",
  "q_fire_2_ans": "1",
  "tip_fire_2": "Dial 101 to call the Fire Brigade. Speak clearly and provide the exact location along with landmarks. Stay calm and follow instructions given on the call.",

  "q_fire_3": "What should you do if your clothes catch fire?",
  "q_fire_3_opt0": "Run",
  "q_fire_3_opt1": "Hide",
  "q_fire_3_opt2": "Stop, Drop, and Roll",
  "q_fire_3_opt3": "Jump",
  "q_fire_3_ans": "2",
  "tip_fire_3": "If your clothes catch fire, Stop running, Drop to the ground, and Roll to extinguish the flames. Running only makes the fire spread faster.",

